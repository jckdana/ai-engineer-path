# Copy to .env and fill in. Never commit .env.
# Only keys actually used by tools/ belong here.

# --- LLM ---
ANTHROPIC_API_KEY=

# --- Google (Sheets / Slides / Drive) ---
# OAuth client downloaded from Google Cloud Console -> credentials.json
# token.json is written on first auth run.
GOOGLE_CREDENTIALS_PATH=credentials.json
GOOGLE_TOKEN_PATH=token.json

# --- Scraping / HTTP ---
FIRECRAWL_API_KEY=
