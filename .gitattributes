# Normalize line endings: LF in the repository, native in the working copy.
# Without this, a Windows checkout stages CRLF and every file looks changed on
# another machine.
* text=auto

*.py    text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.css   text eol=lf
*.j2    text eol=lf
*.html  text eol=lf
*.txt   text eol=lf
